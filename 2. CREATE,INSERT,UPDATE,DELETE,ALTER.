-- Customer Table
CREATE TABLE customer (
-- value datatype constraint
    CustID int PRIMARY KEY,
    CustName varchar(50) NOT NULL,
    Age int NOT NULL,
    City char(50),
    Salary numeric
);

-- Insert values in customer table
